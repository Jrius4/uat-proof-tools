{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://uat-proof-tools/scenario.schema.json",
  "title": "UAT scenario",
  "type": "object",
  "required": ["id", "title", "proves", "platforms", "steps", "expect", "outro"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 90 },
    "proves": { "type": "string", "minLength": 5, "maxLength": 140, "description": "One plain sentence shown on the title card." },
    "platforms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["web", "android", "ios", "desktop"] }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": { "type": "object", "properties": { "baseUrl": { "type": "string" }, "viewport": { "type": "object", "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } } } }, "additionalProperties": false },
        "android": { "type": "object", "properties": { "appId": { "type": "string" } }, "additionalProperties": false },
        "ios": { "type": "object", "properties": { "appId": { "type": "string" } }, "additionalProperties": false },
        "desktop": { "type": "object", "properties": { "command": { "type": "string", "description": "Shell command that drives the app. Call `uatp mark <id>` at each step." } }, "additionalProperties": false }
      }
    },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "do", "narration"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]+$" },
          "do": { "type": "string", "minLength": 2 },
          "narration": { "type": "string", "minLength": 3, "maxLength": 240 },
          "caption": { "type": "string", "maxLength": 80 },
          "sensitive": { "type": "boolean" }
        }
      }
    },
    "expect": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "check", "narration"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^e[0-9]+$" },
          "check": { "type": "string", "minLength": 2 },
          "narration": { "type": "string", "minLength": 3, "maxLength": 240 },
          "caption": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "outro": {
      "type": "object",
      "required": ["pass", "fail"],
      "additionalProperties": false,
      "properties": { "pass": { "type": "string" }, "fail": { "type": "string" } }
    }
  }
}
